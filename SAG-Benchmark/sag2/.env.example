# OpenRouter configuration. Default concurrency: 20.
OPENROUTER_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13

# Agentic SAG2: any compatible model API; no Codex account or CLI is needed.
# For OpenRouter, use https://openrouter.ai/api/v1 and openai/gpt-6.1-sol,
# and pass --llm-api-key-env OPENROUTER_API_KEY instead of duplicating the key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-sol
LLM_API=responses
LLM_REASONING_EFFORT=high

# Hybrid retrieval experiment. Leave keys empty unless the local service requires one.
SAG_EMBEDDING_BASE_URL=http://192.168.2.108:8013/v1
SAG_EMBEDDING_MODEL=bge-m3:latest
SAG_EMBEDDING_API_KEY=
SAG_EMBEDDING_BATCH_SIZE=32
SAG_EMBEDDING_CONCURRENCY=2
SAG_EMBEDDING_DIMENSION=1024

SAG_EVIDENCE_BASE_URL=http://192.168.2.69:9099/v1
SAG_EVIDENCE_MODEL=qwen3.5-397b-a17b
SAG_EVIDENCE_API_KEY=
SAG_EVIDENCE_BATCH_SIZE=10

SAG_RERANK_BASE_URL=http://192.168.2.108:8014/v1
SAG_RERANK_MODEL=bge-reranker-v2-m3
SAG_RERANK_API_KEY=
